# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# VideoSDK Credentials
VIDEOSDK_API_KEY="your_videosdk_api_key_here"
VIDEOSDK_SECRET="your_videosdk_secret_here"
VIDEOSDK_AUTH_TOKEN="your_videosdk_auth_token_here"

# VideoSDK SIP Configuration
VIDEOSDK_SIP_URI="sip:your-org-id.sip.videosdk.live"
VIDEOSDK_OUTBOUND_GATEWAY_ID="your_outbound_gateway_id"

# Twilio Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Application URL (for Twilio Webhooks)
NEXT_PUBLIC_APP_URL="https://your-ngrok-url.ngrok-free.app"